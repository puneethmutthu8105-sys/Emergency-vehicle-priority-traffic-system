# Environment Variables — Road Safety AI
# Copy this file to .env and fill in your API keys

# ── LLM Providers ─────────────────────────────────────────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

OPENAI_API_KEY=your_openai_api_key_here

# ── Weather API ────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Observability (LangFuse) ───────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Security ───────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_VERY_LONG_SECRET_KEY_AT_LEAST_32_CHARS

# ── Database (overrides docker-compose defaults) ───────────────────────
# DATABASE_URL=postgresql+asyncpg://roadsafety:roadsafety123@localhost:5432/roadsafetydb

# ── Simulation Flags ───────────────────────────────────────────────────
USE_SIMULATED_TRAFFIC=true
USE_SIMULATED_AMBULANCE=true
